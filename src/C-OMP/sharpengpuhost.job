#!/bin/bash

# Slurm job options (name, compute nodes, job time)
# This is setup to run in reserved queue for MSc users on 11th Nov
# Outside of this time or project use the default budget

#SBATCH --qos=reservation
#SBATCH --reservation=m26oc-practical_Q3115772
#SBATCH --account=m26oc-practical

# Use below if outside of lab
# #SBATCH --qos=gpu-exc

# Leave these options unchanged

#SBATCH --partition=gpu
#SBATCH --job-name=sharpengpuhost
#SBATCH --time=00:01:00
#SBATCH --output=%x-%j.out
#SBATCH --nodes=1
#SBATCH --gpus=4
#SBATCH --exclusive

# Set the binding

export OMP_PLACES=cores

# Launch the parallel job
# GPU host nodes have 32 CPU-cores
#   srun picks up the distribution from the sbatch options

make clean
make

for t in 1 2 4 8 16 32
do
    export OMP_NUM_THREADS=$t
    srun --ntasks=1 --cpus-per-task=$OMP_NUM_THREADS --cpu-bind=cores ./sharpen
done
